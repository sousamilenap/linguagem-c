#include <stdio.h>
 
int main() {
    char o;
    double m[12][12];
    double soma = 0;
    int quantidade = 0;
    
    scanf(" %c", &o);
    
    for(int i = 0; i < 12; i++){
        for(int j = 0; j < 12; j++){
            scanf("%lf", &m[i][j]);
            if(j > i){
                soma += m[i][j];
                quantidade++;
            }
        }
    }
    if(o == 'M'){
        soma = soma / quantidade;
    }
    printf("%.1lf\n", soma);

    return 0;
}
