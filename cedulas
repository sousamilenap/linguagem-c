#include <stdio.h>

int main(){
    int n, total, resto;

    scanf("%d", &n);
    printf("%d\n", n);

    total = n / 100;
    printf("%d nota(s) de R$ 100,00\n", total);
    resto = n % 100;

    total = resto / 50;
    printf("%d nota(s) de R$ 50,00\n",total);
    resto = resto % 50;

    total = resto / 20;
    printf("%d nota(s) de R$ 20,00\n", total);
    resto = resto % 20;

    total = resto / 10;
    printf("%d nota(s) de R$ 10,00\n", total);
    resto = resto % 10;

    total = resto /5;
    printf("%d nota(s) de R$ 5,00\n", total);
    resto = resto % 5;

    total = resto /2;
    printf("%d nota(s) de R$ 2,00\n", total);
    resto = resto % 2;

    total = resto /1;
    printf("%d nota(s) de R$ 1,00\n", total);
    resto = resto % 1;

    return 0;


}
