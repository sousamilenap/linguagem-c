#include <stdio.h>
 
int main() {
    int codigo = 0;
    int alcool = 0, gasolina = 0, diesel = 0;
    
    while(codigo != 4){
        scanf("%d", &codigo);
        
        switch(codigo){
            case 1: alcool++;
            break;
            
            case 2: gasolina++;
            break;
            
            case 3: diesel++;
            break;
            
        }
    }
    printf("MUITO OBRIGADO\n");
    printf("Alcool: %d\n", alcool);
    printf("Gasolina: %d\n", gasolina);
    printf("Diesel: %d\n", diesel);
 
    return 0;
}
