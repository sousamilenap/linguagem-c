#include <stdio.h>

int main() {
    int n, i, j;

    while(scanf("%d", &n) != EOF) {
        int matriz[n][n];

        for(i = 0; i < n; i++) {
            for(j = 0; j < n; j++) {
                matriz[i][j] = 3;
            }
        }
        for(i = 0; i < n; i++) {
            matriz[i][i] = 1;
        }
        for(i = 0; i < n; i++) {
            matriz[i][n - 1 - i] = 2;
        }
        for(i = 0; i < n; i++) {
            for(j = 0; j < n; j++) {
                printf("%d", matriz[i][j]);
            }
            printf("\n");
        }
    }
    return 0;
}
