    //Devemos colocar 10.0

    if(media>=7.0){
        printf("Aluno aprovado.\n");
        return 0;
    }
    if(media<5.0){
        printf("Aluno reprovado.\n");
        return 0;
    }
    if((media>=5.0) && (media<= 6.9)){
        printf("Aluno em exame.\n");

        scanf("%f", &nExame);
        printf("Nota do exame: %.1f\n", nExame);

        mediaNovo=(media + nExame)/2.0;

        if(mediaNovo>=5.0){
            printf("Aluno aprovado.\n");

        }else{
        printf("Aluno reprovado.\n");

        }
         printf("Media final: %.1f\n", mediaNovo);
    }

}
